# Credenciales de vTiger. Copia este archivo a .env y pon las tuyas.
#
#   cp .env.example .env
#
# La access key NO es tu contrasena: se saca de vTiger, en
# My Preferences, seccion "Access Key". Si alguna vez se filtra, se rota
# desde esa misma pantalla y la anterior deja de servir al instante.
#
# .env esta en .gitignore y no se sube nunca.

VTIGER_USERNAME=tu.usuario@tuempresa.com
VTIGER_ACCESS_KEY=pon_aqui_tu_access_key

# URL de tu instancia de vTiger, sin barra final.
VTIGER_URL=https://tuempresa.od2.vtiger.com
